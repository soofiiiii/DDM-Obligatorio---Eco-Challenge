{
  "expo": {
    "name": "EcoChallenge",
    "slug": "EcoChallenge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "package": "com.soofiiiii.EcoChallenge",
      "jsEngine": "jsc",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "runtimeVersion": "1.0.0"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "mode": "development",
          "android": {
            "icon": "./assets/notification-icon.png",
            "color": "#4CAF50"
          },
          "ios": {
            "allowCriticalAlerts": false,
            "shouldSetBadge": true,
            "shouldPlaySound": true
          },
          "shouldShowBanner": true,
          "shouldShowList": true
        }
      ],
      "expo-secure-store"
    ],
    "notification": {
      "iosDisplayInForeground": true,
      "androidMode": "default",
      "androidModeAdjacency": "overlap",
      "shouldShowBanner": true,
      "shouldShowList": true
    },
    "extra": {
      "eas": {
        "projectId": "e4461ac9-12a5-41e2-8446-7620369c1071"
      }
    },
    "owner": "soofiiiii",
    "updates": {
      "url": "https://u.expo.dev/e4461ac9-12a5-41e2-8446-7620369c1071"
    },
    "ios": {
      "runtimeVersion": {
        "policy": "appVersion"
      }
    }
  }
}
